## Copy this file to keystore.properties (same folder) and fill in the real values.
## keystore.properties is read by android/app/build.gradle for release signing.
## Never share this file or commit it anywhere — it contains your signing passwords.

storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD_HERE
keyAlias=wastatusapp-upload
keyPassword=YOUR_KEY_PASSWORD_HERE
